// DCSync - Directory Replication Rights Abuse
SecurityEvent
| where EventID == "4662"
| where (Properties contains "1131f6aa-9c07-11d1-f79f-00c04fc2dcd2" or Properties contains "1131f6ad-9c07-11d1-f79f-00c04fc2dcd2")
| where not(SubjectUserName endswith "$")
| where not(SubjectUserName startswith "MSOL_")
